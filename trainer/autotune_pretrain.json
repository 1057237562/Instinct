{
  "args": {
    "config_path": "trainer/config_pretrain.json",
    "hidden_size": 512,
    "num_hidden_layers": 32,
    "use_moe": 1,
    "from_weight": "none",
    "data_path": "dataset/pretrain_coder_12b.parquet",
    "device": "cuda:0",
    "batch_size": 1,
    "epochs": 1,
    "max_seq_len": 4096,
    "sequence_packing": 1,
    "sequence_packing_mode": "bucket",
    "seq_bucket": 2,
    "bucket_gpu_memory_gb": "auto",
    "bucket_token_budget": 0,
    "bucket_max_seq_len": 4096,
    "bucket_large_threshold": 4096,
    "packing_batch_size": 1000,
    "packing_num_proc": 4,
    "bucket_loader_workers": 0,
    "num_workers": 0,
    "data_cache_max_gb": 9,
    "dataset_streaming": "on",
    "streaming_chunk_mb": 1024,
    "streaming_prefetch_chunks": 1,
    "cache_build_mode": "inline",
    "optimizer": "muon",
    "dtype": "bfloat16",
    "param_dtype": "fp32",
    "fp8_training": "tensorwise",
    "fp8_filter": "auto",
    "kv_cache_dtype": "fp8_e5m2",
    "use_grad_checkpoint": 1,
    "use_compile": 1,
    "compile_mode": "max-autotune-no-cudagraphs",
    "accumulation_steps": 1,
    "learning_rate": 0.0005,
    "warmup_ratio": 0,
    "min_lr_ratio": 0.1,
    "log_interval": 100
  },
  "environment": {}
}
